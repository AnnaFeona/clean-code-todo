{
  "name": "clean-code-todo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "**/*.{js,html,css,json,md}": [
      "prettier",
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.0.0",
    "prettier": "^3.9.10"
  }
}
